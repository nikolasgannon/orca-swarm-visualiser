{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "swarm-visualiser",
  "name": "Swarm Visualiser",
  "version": "0.4.0",
  "description": "Real-time visualiser and control bridge for multi-agent swarms in Orca.",
  "author": {
    "name": "Nikolas Gannon",
    "url": "https://github.com/nikolasgannon"
  },
  "icon": "images/icon.png",
  "cover": {
    "path": "images/cover.png",
    "alt": "Swarm Visualiser live agent topology graph, workspace controls, and past session list in dark mode"
  },
  "screenshots": [
    {
      "path": "images/screenshot-graph.png",
      "alt": "Interactive swarm topology graph showing active coding agents, live message edges, and event feed",
      "caption": "Live swarm topology graph with message flow edges and event timeline"
    },
    {
      "path": "images/screenshot-steer.png",
      "alt": "Steer drawer with one-click terminal focus, outcome badge, session identifier, and hand-off controls",
      "caption": "Steer active worktrees, inspect outcome status, and focus Orca terminals in one click"
    },
    {
      "path": "images/screenshot-sessions.png",
      "alt": "Team roster alongside expandable Past Sessions list with branch filters and one-click Resume buttons",
      "caption": "Browse worktree agent rosters and resume recent Orca sessions in one click"
    }
  ],
  "license": "MIT",
  "repository": "https://github.com/nikolasgannon/orca-swarm-visualiser",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "swarm",
        "title": "Swarm Visualiser",
        "icon": "activity",
        "entry": "bridge/public/index.html"
      }
    ],
    "commands": [
      {
        "id": "swarm-visualiser.open",
        "title": "Swarm: Open Swarm Visualiser"
      },
      {
        "id": "swarm-visualiser.openTab",
        "title": "Swarm: Open Swarm Tab (Full Window)"
      },
      {
        "id": "swarm-visualiser.relaunchLast",
        "title": "Swarm: Relaunch last preset",
        "when": "workspace"
      }
    ],
    "keybindings": [
      {
        "command": "swarm-visualiser.open",
        "key": "Mod+Alt+S",
        "when": "global"
      },
      {
        "command": "swarm-visualiser.relaunchLast",
        "key": "Mod+Alt+L",
        "when": "workspace"
      }
    ],
    "hooks": [
      {
        "event": "agent.launch.before"
      }
    ],
    "statusBarItems": [
      {
        "id": "swarm-open",
        "text": "Swarm",
        "icon": "activity",
        "tone": "accent",
        "tooltip": "Open Swarm Visualiser",
        "command": "swarm-visualiser.open"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      },
      {
        "on": "workspace.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "history:read"
    },
    {
      "kind": "agent:launch"
    }
  ]
}
